{
  "name": "ferrodock-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm api:types && tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm api:types && tsc --noEmit -p .",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "api:types": "openapi-typescript ../openapi.json -o src/shared/api/schema.d.ts",
    "size": "node scripts/initial-size.mjs"
  },
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@hookform/resolvers": "7.0.8",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "motion": "14.14.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-plugin": "1.169.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "openapi-typescript": "7.13.0",
    "stylelint": "18.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
