{
  "openapi": "3.1.0",
  "info": {
    "title": "FerroDock API",
    "description": "Self-hosted PaaS control plane",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.1.1"
  },
  "paths": {
    "/api/v1/api-keys": {
      "get": {
        "tags": [
          "api-keys"
        ],
        "description": "Lists active API keys of the caller in the active organization",
        "operationId": "list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApiKeyDto"
                  }
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "api-keys"
        ],
        "description": "Creates an API key; the secret is returned only in this response",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApiKeyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedApiKeyResponse"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/api-keys/{id}": {
      "delete": {
        "tags": [
          "api-keys"
        ],
        "description": "Revokes one of the caller's API keys",
        "operationId": "revoke",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "API key id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {},
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "description": "Returns the signed-in user with organization memberships",
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/sign-in": {
      "post": {
        "tags": [
          "auth"
        ],
        "description": "Signs in with email and password and sets an HttpOnly session cookie",
        "operationId": "sign_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts from this address"
          }
        }
      }
    },
    "/api/v1/auth/sign-out": {
      "post": {
        "tags": [
          "auth"
        ],
        "description": "Ends the current session and clears the session cookie",
        "operationId": "sign_out",
        "responses": {
          "204": {},
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/docker/containers": {
      "get": {
        "tags": [
          "docker"
        ],
        "description": "Containers on this server, running only unless all=true; requires the admin role",
        "operationId": "list_containers",
        "parameters": [
          {
            "name": "all",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ContainerDto"
                  }
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/docker/containers/{reference}/actions": {
      "post": {
        "tags": [
          "docker"
        ],
        "description": "Starts, stops or restarts a container by id or name; requires the admin role",
        "operationId": "container_action",
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "description": "Container id or name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContainerActionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {},
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/docker/info": {
      "get": {
        "tags": [
          "docker"
        ],
        "description": "Docker engine version on this server; requires the admin role",
        "operationId": "docker_info",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EngineInfoDto"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "description": "Liveness and database readiness of the control plane",
        "operationId": "check",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/setup": {
      "get": {
        "tags": [
          "setup"
        ],
        "description": "Reports whether the first owner account still has to be created",
        "operationId": "status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "setup"
        ],
        "description": "Creates the first owner and organization, then signs the owner in",
        "operationId": "complete",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiKeyDto": {
        "type": "object",
        "required": [
          "id",
          "name",
          "prefix",
          "role",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "last_used_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "name": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/RoleDto"
          }
        }
      },
      "ContainerActionDto": {
        "type": "string",
        "enum": [
          "start",
          "stop",
          "restart"
        ]
      },
      "ContainerActionRequest": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "$ref": "#/components/schemas/ContainerActionDto"
          }
        }
      },
      "ContainerDto": {
        "type": "object",
        "required": [
          "id",
          "short_id",
          "name",
          "image",
          "state",
          "status",
          "created",
          "managed",
          "protected"
        ],
        "properties": {
          "compose_project": {
            "type": [
              "string",
              "null"
            ]
          },
          "created": {
            "type": "integer",
            "format": "int64"
          },
          "id": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "managed": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "protected": {
            "type": "boolean"
          },
          "short_id": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "CreateApiKeyRequest": {
        "type": "object",
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "expires_in_days": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/RoleDto"
          }
        }
      },
      "CreatedApiKeyResponse": {
        "type": "object",
        "required": [
          "key",
          "api_key"
        ],
        "properties": {
          "api_key": {
            "$ref": "#/components/schemas/ApiKeyDto"
          },
          "key": {
            "type": "string"
          }
        }
      },
      "EngineInfoDto": {
        "type": "object",
        "required": [
          "version",
          "api_version",
          "os",
          "arch"
        ],
        "properties": {
          "api_version": {
            "type": "string"
          },
          "arch": {
            "type": "string"
          },
          "os": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message",
          "params"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "params": {
            "type": "object"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "version",
          "database"
        ],
        "properties": {
          "database": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "required": [
          "id",
          "email",
          "name",
          "locale",
          "theme",
          "active_organization_id",
          "memberships"
        ],
        "properties": {
          "active_organization_id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "locale": {
            "type": "string"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MembershipDto"
            }
          },
          "name": {
            "type": "string"
          },
          "theme": {
            "type": "string"
          }
        }
      },
      "MembershipDto": {
        "type": "object",
        "required": [
          "organization_id",
          "organization_name",
          "organization_slug",
          "role"
        ],
        "properties": {
          "organization_id": {
            "type": "string",
            "format": "uuid"
          },
          "organization_name": {
            "type": "string"
          },
          "organization_slug": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/RoleDto"
          }
        }
      },
      "RoleDto": {
        "type": "string",
        "enum": [
          "viewer",
          "developer",
          "admin",
          "owner"
        ]
      },
      "SetupRequest": {
        "type": "object",
        "required": [
          "email",
          "name",
          "password",
          "organization_name"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "locale": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "organization_name": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          },
          "setup_token": {
            "type": [
              "string",
              "null"
            ],
            "format": "password"
          }
        }
      },
      "SetupStatus": {
        "type": "object",
        "required": [
          "required",
          "token_required"
        ],
        "properties": {
          "required": {
            "type": "boolean"
          },
          "token_required": {
            "type": "boolean"
          }
        }
      },
      "SignInRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      }
    }
  }
}